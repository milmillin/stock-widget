# Deploy config for the widget. Copy to .env and fill in — or just run:
#   node scripts/keygen.mjs      (generates the key pair and writes .env)
#
# .env is the SOURCE OF TRUTH. `node scripts/build-config.mjs` compiles the public
# values (WORKER_BASE_URL, PUBLIC_KEY) into site/config.js, which the browser loads.
# .env is gitignored; site/config.js is committed.

# ── Public (safe to expose; end up in site/config.js) ──────────────────────────
# Your deployed Worker URL (set after the first deploy).
WORKER_BASE_URL=https://stock-widget.YOUR-SUBDOMAIN.workers.dev
# RSA-OAEP public key (SPKI base64). The site encrypts Alpaca creds with this.
PUBLIC_KEY=

# ── Secret (never commit) ──────────────────────────────────────────────────────
# RSA-OAEP private key (PKCS8 base64). Decrypts the creds in the Worker.
# Synced to worker/.dev.vars locally; in prod:  cd worker && npx wrangler secret put PRIVATE_KEY
PRIVATE_KEY=
